# ============================================================
# MINIME 설정. 이 파일을 .env로 복사해서 고치세요.  (cp .env.example .env)
# 아무것도 안 바꿔도 동작합니다: 모델이 없으면 '규칙 대체'로 회의가 계속돼요.
# ============================================================

# ---- 엔진 순서: 앞에서부터 시도하고 실패하면 다음으로. 마지막엔 항상 규칙 대체.
#   로컬만:        LLM_ORDER=ollama
#   로컬 → API:    LLM_ORDER=ollama,api      (기본)
#   API만:         LLM_ORDER=api             ← 로컬 모델이 잘 안 되면 이 한 줄만 바꾸세요
#   규칙만(시연):  LLM_ORDER=rule
LLM_ORDER=ollama,api

# ---- 로컬 Ollama (ollama pull qwen3.5:4b / qwen3.5:9b / bge-m3)
OLLAMA_BASE=http://localhost:11434
FAST_MODEL=qwen3.5:4b
SLOW_MODEL=qwen3.5:9b
EMBED_MODEL=bge-m3

# ---- 클라우드 API (OpenAI 호환이면 무엇이든). 키가 없으면 이 단계는 건너뜀.
# OpenAI
API_BASE=https://api.openai.com/v1
API_KEY=
API_FAST_MODEL=gpt-4o-mini
API_SLOW_MODEL=gpt-4o-mini
# Groq (빠름, 무료 한도)   API_BASE=https://api.groq.com/openai/v1        API_FAST_MODEL=openai/gpt-oss-20b
# Gemini (OpenAI 호환)    API_BASE=https://generativelanguage.googleapis.com/v1beta/openai   API_SLOW_MODEL=gemini-2.5-flash
# OpenRouter              API_BASE=https://openrouter.ai/api/v1             API_SLOW_MODEL=google/gemma-3-27b-it:free
# 서비스가 response_format(JSON 모드)을 거부하면 0으로
API_JSON_MODE=1

# ---- 시간 제한(초)과 서킷 브레이커
FAST_TIMEOUT=2.5
SLOW_TIMEOUT=30
API_FAST_TIMEOUT=6
API_SLOW_TIMEOUT=30
BREAKER_FAILS=3
BREAKER_COOLDOWN=45

# ---- 개입 게이트(M2): rule(후보 A) | hybrid(후보 C, 기본) | llm(후보 D)
GATE_MODE=hybrid
GATE_HIGH=0.42
GATE_LOW=0.22
GATE_MID=0.32
COOLDOWN_SEC=12

# ---- 근거(M1): 이 점수 아래면 말하지 않음. python eval/eval.py --sweep 으로 다시 정하세요.
EVIDENCE_MIN=0.35
RETRIEVAL_METHOD=hybrid

# ---- 근거 검증: 미니미 문장의 사실 부분(core)을 인용 문단이 함의하는지 NLI 모델로 판정
#   auto(기본): NLI 모델이 있으면 NLI, 없으면 핵심어 검사 | nli | lexical | off
#   NLI 설치: pip install torch --index-url https://download.pytorch.org/whl/cpu && pip install -r requirements-ml.txt
VERIFY_MODE=auto
VERIFY_THRESHOLD=0.5
# NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
# TONE_SLACK=25

# ---- 안건 이탈(M4)
DRIFT_THRESHOLD=0.80
DRIFT_K=2

# ---- 선택: 2차 검증에서 팀 자료에 근거가 없을 때 웹 검색 (Tavily 무료 한도)
TAVILY_API_KEY=

# ---- 배포·접속
# QR 초대 링크에 쓸 주소 (비우면 이 노트북의 와이파이 IP로 자동)
PUBLIC_URL=
ALLOW_ORIGINS=*
DATA_DIR=data

# ---- 실전 시연 자동 진행 (실전 시연용 방에서 동준이 대리 참석을 켜면 대사가 대본 순서대로 나감)
LIVE_AUTOPLAY=1
LIVE_AUTOPLAY_SPEED=1.0
